<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- 目标运行时使用.NET 8。 -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- 启用可空引用检查。 -->
    <Nullable>enable</Nullable>
    <!-- 导入SDK通用命名空间。 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 本机用户机密标识；真实连接和密码不写入项目。 -->
    <UserSecretsId>library-lending-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Identity账号和角色的EF存储。 -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.25"/>
    <!-- 仅在开发期提供迁移工具，不向使用方传递。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.25">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MySQL连接与数据库错误识别。 -->
    <PackageReference Include="MySqlConnector" Version="2.6.1"/>
    <!-- EF Core的MySQL提供程序。 -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3"/>
    <!-- 专用Roslyn安全分析器，构建时扫描源码且不向消费项目传递。 -->
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
