@model LoginInput
@{ ViewData["Title"] = "Sign in"; }
<div class="login-layout"><section class="intro"><p class="eyebrow">YOUR LIBRARY, TOGETHER</p><h1>A place for every book.<br/>A simpler way to lend.</h1><p>Manage your collection and keep every loan in view.</p><div class="book-art" aria-hidden="true"><span>CATALOG</span><span>DISCOVER</span><span>BORROW</span></div></section><section class="card login-card"><p class="eyebrow">WELCOME BACK</p><h2>Sign in to your library</h2><p class="muted">Use the email and password for your account.</p><form method="post" asp-action="Login"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden"/><label asp-for="Email"></label><input asp-for="Email" autocomplete="username"/><span asp-validation-for="Email" class="validation"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" value=""/><span asp-validation-for="Password" class="validation"></span><button type="submit">Sign in</button></form></section></div>
