@model IReadOnlyList<BookRow>
@{ ViewData["Title"] = "Books"; }
<div class="page-heading"><div><p class="eyebrow">COLLECTION</p><h1>Books</h1><p class="muted">@Model.Count titles in your catalog</p></div><a class="button" asp-action="Create">+ Add book</a></div><div class="table-wrap"><table><thead><tr><th>Title / ISBN</th><th>Author</th><th>Category</th><th>Total copies</th><th>Available</th></tr></thead><tbody>@foreach(var book in Model){<tr><td><strong>@book.Title</strong><small>@book.Isbn</small></td><td>@book.Author</td><td>@(book.Category ?? "—")</td><td>@book.TotalCopies</td><td><span class="badge">@book.AvailableCopies available</span></td></tr>}</tbody></table>@if(Model.Count == 0){<p class="empty">Your catalog is ready for its first book.</p>}</div>
