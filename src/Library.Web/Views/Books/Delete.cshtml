@model Book
@{ ViewData["Title"] = "Delete book"; }
<p class="eyebrow">COLLECTION</p><h1>Delete book?</h1><section class="card form-card"><p><strong>@Model.Title</strong></p><p class="muted">ISBN: @Model.Isbn. Books with any loan history are protected from deletion.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><div class="form-actions"><button type="submit">Confirm delete</button><a asp-action="Index">Cancel</a></div></form></section>
