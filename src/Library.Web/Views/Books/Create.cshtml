@model BookInput
@{ ViewData["Title"] = "Add book"; }
<p class="eyebrow">COLLECTION</p><h1>Add a book</h1><section class="card form-card"><p class="muted">ISBN, title, author, and total copies are required.</p><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><label asp-for="Isbn"></label><input asp-for="Isbn" required/><span asp-validation-for="Isbn" class="validation"></span><label asp-for="Title"></label><input asp-for="Title" required/><span asp-validation-for="Title" class="validation"></span><label asp-for="Author"></label><input asp-for="Author" required/><span asp-validation-for="Author" class="validation"></span><label asp-for="Category">Category (optional)</label><input asp-for="Category"/><span asp-validation-for="Category" class="validation"></span><label asp-for="TotalCopies"></label><input asp-for="TotalCopies" type="number" min="0" step="1" required/><span asp-validation-for="TotalCopies" class="validation"></span><div class="form-actions"><button type="submit">Add book</button><a asp-action="Index">Cancel</a></div></form></section>
