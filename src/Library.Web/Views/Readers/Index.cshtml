@model IReadOnlyList<Reader>
@{ ViewData["Title"] = "Readers"; }
<div class="page-heading"><div><p class="eyebrow">COMMUNITY</p><h1>Readers</h1><p class="muted">@Model.Count reader profiles</p></div><a class="button" asp-action="Create">+ Create reader</a></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th></tr></thead><tbody>@foreach(var reader in Model){<tr><td><strong>@reader.Name</strong></td><td>@reader.Email</td><td>@(reader.Phone ?? "—")</td></tr>}</tbody></table>@if(Model.Count == 0){<p class="empty">No reader profiles yet.</p>}</div>
