@model ReaderDirectory
@{ ViewData["Title"] = "Readers"; }
<div class="page-heading"><div><p class="eyebrow">COMMUNITY</p><h1>Readers</h1><p class="muted">@Model.Readers.Count matching reader profiles</p></div><a class="button" asp-action="Create">+ Create reader</a></div>
<form method="get" class="search-bar"><div><label for="q">Search name or email</label><input id="q" name="q" value="@Model.Query" maxlength="256" /></div><div><label for="sort">Sort by name</label><select id="sort" name="sort"><option value="name" selected="@(Model.Sort == "name")">Name A–Z</option><option value="name_desc" selected="@(Model.Sort == "name_desc")">Name Z–A</option></select></div><button type="submit">Search</button><a asp-action="Index">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Manage</th></tr></thead><tbody>@foreach(var reader in Model.Readers){<tr data-reader-id="@reader.Id"><td><strong>@reader.Name</strong></td><td>@reader.Email</td><td>@(reader.Phone ?? "—")</td><td><a asp-action="Edit" asp-route-id="@reader.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@reader.Id">Delete</a></td></tr>}</tbody></table>@if(Model.Readers.Count == 0){<p class="empty">No readers match your search.</p>}</div>
