@model ReaderInput
@{ ViewData["Title"] = "Create reader"; }
<p class="eyebrow">COMMUNITY</p><h1>Create a reader</h1><section class="card form-card"><p class="muted">Name, email, and initial password are required. The new account receives reader access.</p><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><label asp-for="Name"></label><input asp-for="Name" required/><span asp-validation-for="Name" class="validation"></span><label asp-for="Email"></label><input asp-for="Email" required/><span asp-validation-for="Email" class="validation"></span><label asp-for="Phone">Phone (optional)</label><input asp-for="Phone"/><span asp-validation-for="Phone" class="validation"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" value="" required/><span asp-validation-for="Password" class="validation"></span><small>At least 8 characters, including a letter and a number.</small><div class="form-actions"><button type="submit">Create reader</button><a asp-action="Index">Cancel</a></div></form></section>
