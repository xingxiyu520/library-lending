@* 创建读者及登录账号的表单，客户端没有角色选择字段。 *@
@model ReaderInput
@{ ViewData["Title"] = "Create reader"; }
<p class="eyebrow">COMMUNITY</p>
<h1>Create a reader</h1>
<section class="card form-card">
<p class="muted">Name, email, and initial password are required. The new account receives reader access.</p>
@* 提交表单由标签助手生成防伪字段，服务端负责授权和业务校验。 *@
<form asp-action="Create" method="post">
@* 展示跨字段、业务规则及事务失败信息。 *@
<div asp-validation-summary="ModelOnly" class="validation" role="alert">
</div>
@* 读者姓名输入及服务端错误提示。 *@
<label asp-for="Name">
</label>
<input asp-for="Name" required/>
<span asp-validation-for="Name" class="validation">
</span>
@* 邮箱输入与字段错误提示，服务端规范化后参与账号操作。 *@
<label asp-for="Email">
</label>
<input asp-for="Email" required/>
<span asp-validation-for="Email" class="validation">
</span>
@* 可选电话号码输入及错误提示。 *@
<label asp-for="Phone">Phone (optional)</label>
<input asp-for="Phone"/>
<span asp-validation-for="Phone" class="validation">
</span>
@* 密码输入只用于提交，不在验证失败页面回填。 *@
<label asp-for="Password">
</label>
<input asp-for="Password" autocomplete="new-password" value="" required/>
<span asp-validation-for="Password" class="validation">
</span>
<small>At least 8 characters, including a letter and a number.</small>
@* 确认按钮触发提交，取消链接返回列表且不写入数据。 *@
<div class="form-actions">
<button type="submit">Create reader</button>
<a asp-action="Index">Cancel</a>
</div>
</form>
</section>
