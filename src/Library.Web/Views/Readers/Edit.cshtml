@model ReaderEditInput
@{ ViewData["Title"] = "Edit reader"; }
<p class="eyebrow">COMMUNITY</p><h1>Edit reader</h1><section class="card form-card"><p class="muted">Email changes also update the login account. Existing sessions will require sign-in again.</p><form asp-action="Edit" asp-route-id="@ViewData["Id"]" method="post"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><label asp-for="Name"></label><input asp-for="Name" required/><span asp-validation-for="Name" class="validation"></span><label asp-for="Email"></label><input asp-for="Email" type="email" required/><span asp-validation-for="Email" class="validation"></span><label asp-for="Phone">Phone (optional)</label><input asp-for="Phone"/><span asp-validation-for="Phone" class="validation"></span><div class="form-actions"><button type="submit">Save reader</button><a asp-action="Index">Cancel</a></div></form></section>
