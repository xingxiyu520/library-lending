@model Reader
@{ ViewData["Title"] = "Delete reader"; }
<p class="eyebrow">COMMUNITY</p><h1>Delete reader?</h1><section class="card form-card"><p><strong>@Model.Name</strong> — @Model.Email</p><p class="muted">This also removes the login account and ends its access. Readers with any loan history cannot be deleted.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><div class="form-actions"><button type="submit">Confirm delete</button><a asp-action="Index">Cancel</a></div></form></section>
