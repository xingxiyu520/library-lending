@model MyLoansPage
@{ ViewData["Title"] = "My loans"; }
<p class="eyebrow">READER WORKSPACE</p><h1>My loans</h1><p class="muted">Your borrowing history and return dates.</p>
@if(Model.MissingProfile){<section class="card"><p role="alert">Your account is not linked to an active reader profile. Please contact your librarian.</p></section>}else{<div class="table-wrap"><table><thead><tr><th>Book</th><th>Borrowed</th><th>Due date</th><th>Returned</th><th>Status</th></tr></thead><tbody>@foreach(var loan in Model.Loans){<tr data-loan-id="@loan.Id"><td><strong>@loan.Title</strong></td><td>@loan.BorrowDate.ToString("yyyy-MM-dd")</td><td>@loan.DueDate.ToString("yyyy-MM-dd")</td><td>@(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "—")</td><td><span class="badge @(loan.Status == "Overdue" ? "overdue" : "")">@loan.Status</span></td></tr>}</tbody></table>@if(Model.Loans.Count == 0){<p class="empty">You have no loan records yet.</p>}</div>}
