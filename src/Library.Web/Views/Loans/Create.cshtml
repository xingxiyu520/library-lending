@model LoanInput
@{ ViewData["Title"] = "Record loan"; }
<p class="eyebrow">CIRCULATION</p><h1>Record a loan</h1><section class="card form-card"><p class="muted">All fields are required. Each loan reserves one copy.</p><form asp-action="Create" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="RequestId" type="hidden"/><label asp-for="BookId"></label><select asp-for="BookId" asp-items="Model.Books" required><option value="">Choose a book</option></select><span asp-validation-for="BookId" class="validation"></span><label asp-for="ReaderId"></label><select asp-for="ReaderId" asp-items="Model.Readers" required><option value="">Choose a reader</option></select><span asp-validation-for="ReaderId" class="validation"></span><label asp-for="BorrowDate"></label><input asp-for="BorrowDate" type="date" required/><span asp-validation-for="BorrowDate" class="validation"></span><label asp-for="DueDate"></label><input asp-for="DueDate" type="date" required/><span asp-validation-for="DueDate" class="validation"></span><div class="form-actions"><button type="submit">Record loan</button><a asp-action="Index">Cancel</a></div></form></section>
