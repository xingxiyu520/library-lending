@model ReturnInput
@{ ViewData["Title"] = "Return book"; var loan = (Loan)ViewData["Loan"]!; }
<p class="eyebrow">CIRCULATION</p><h1>Return book</h1><section class="card form-card"><p><strong>@loan.Book.Title</strong></p><p class="muted">Borrowed @loan.BorrowDate.ToString("yyyy-MM-dd") · Due @loan.DueDate.ToString("yyyy-MM-dd")</p>@if(loan.ReturnDate.HasValue){<p class="notice">This loan has already been returned on @loan.ReturnDate.Value.ToString("yyyy-MM-dd").</p>}<form asp-action="Return" asp-route-id="@loan.Id" method="post"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><label asp-for="ReturnDate"></label><input asp-for="ReturnDate" type="date" required/><span asp-validation-for="ReturnDate" class="validation"></span><div class="form-actions">@if(!loan.ReturnDate.HasValue){<button type="submit">Confirm return</button>}<a asp-action="Index">Back to loans</a></div></form></section>
