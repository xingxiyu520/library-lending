@model IReadOnlyList<Loan>
@{ ViewData["Title"] = "Loans"; }
<div class="page-heading"><div><p class="eyebrow">CIRCULATION</p><h1>Loans</h1><p class="muted">Every loan, clearly recorded.</p></div><a class="button" asp-action="Create">+ Record loan</a></div><div class="table-wrap"><table><thead><tr><th>Book</th><th>Reader</th><th>Borrowed</th><th>Due date</th><th>Status</th></tr></thead><tbody>@foreach(var loan in Model){<tr><td><strong>@loan.Book.Title</strong></td><td>@loan.Reader.Name</td><td>@loan.BorrowDate.ToString("yyyy-MM-dd")</td><td>@loan.DueDate.ToString("yyyy-MM-dd")</td><td><span class="badge">@(loan.ReturnDate is null ? "On loan" : "Returned")</span></td></tr>}</tbody></table>@if(Model.Count == 0){<p class="empty">No loans recorded. Ready for the first chapter?</p>}</div>
