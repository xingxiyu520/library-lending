@* 管理员借阅列表，组合查询结果来自统一查询服务。 *@
@model LoanListPage
@{ ViewData["Title"] = "Loans"; }
@* 管理员列表包含读者姓名与操作；每行编号供回归测试准确定位。 *@
<div class="section-head">
<div>
<p class="eyebrow">CIRCULATION</p>
<h1>Loans</h1>
</div>
<a class="button" asp-action="Create">Record a loan</a>
</div>
<partial name="_LoanFilters" model="Model"/>
@* 结果表格保留行标识供端到端测试定位，动态文本由Razor编码输出。 *@
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Book</th>
<th>Reader</th>
<th>Borrowed</th>
<th>Due date</th>
<th>Returned</th>
<th>Status</th>
<th>Manage</th>
</tr>
</thead>
<tbody>
@foreach(var loan in Model.Loans){
 <tr data-loan-id="@loan.Id">
<td>
<strong>@loan.Title</strong>
</td>
<td>@loan.ReaderName</td>
<td>@loan.BorrowDate.ToString("yyyy-MM-dd")</td>
<td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
<td>@(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "—")</td>
<td>
<span class="badge @(loan.Status == "Overdue" ? "overdue" : "")">@loan.Status</span>
</td>
<td>
<a asp-action="Edit" asp-route-id="@loan.Id">Correct dates</a>
 @if(loan.ReturnDate is null){
<a asp-action="Return" asp-route-id="@loan.Id">Return</a>
<a asp-action="Delete" asp-route-id="@loan.Id">Delete mistaken loan</a>
}</td>
</tr>
}
</tbody>
</table>
@if(Model.Loans.Count == 0){
<p class="empty">@(Model.Filters.Query.Length > 0 || Model.Filters.Status != "all" ? "No loans match your search." : "No loans recorded. Ready for the first chapter?")</p>
}
</div>
