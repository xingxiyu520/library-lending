@model IReadOnlyList<Loan>
@inject Library.Web.Services.BusinessClock Clock
@{ ViewData["Title"] = "Loans"; var today = Clock.Today; }
<div class="page-heading"><div><p class="eyebrow">CIRCULATION</p><h1>Loans</h1><p class="muted">Every loan, clearly recorded.</p></div><a class="button" asp-action="Create">+ Record loan</a></div><div class="table-wrap"><table><thead><tr><th>Book</th><th>Reader</th><th>Borrowed</th><th>Due date</th><th>Returned</th><th>Status</th><th>Manage</th></tr></thead><tbody>@foreach(var loan in Model){var status = Library.Web.Services.LendingRules.LoanStatus(loan.DueDate, loan.ReturnDate, today);<tr data-loan-id="@loan.Id"><td><strong>@loan.Book.Title</strong></td><td>@loan.Reader.Name</td><td>@loan.BorrowDate.ToString("yyyy-MM-dd")</td><td>@loan.DueDate.ToString("yyyy-MM-dd")</td><td>@(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "—")</td><td><span class="badge @(status == "Overdue" ? "overdue" : "")">@status</span></td><td>@if(loan.ReturnDate is null){<a asp-action="Return" asp-route-id="@loan.Id">Return</a>}</td></tr>}</tbody></table>@if(Model.Count == 0){<p class="empty">No loans recorded. Ready for the first chapter?</p>}</div>
