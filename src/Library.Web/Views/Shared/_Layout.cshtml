@* 公共布局，按登录角色呈现导航并承载页面内容与成功提示。 *@
<!DOCTYPE html>
<html lang="en">
<head>
@* 统一字符集、移动端视口及带版本号的本站样式。 *@
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · Library Lending</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
@* 导航按认证状态及角色显示，真正的访问限制由控制器授权执行。 *@
<header class="topbar">
<a class="brand" asp-controller="Home" asp-action="Index">
<span class="brand-mark">L</span> Library Lending</a>
@if(User.Identity?.IsAuthenticated == true){
<nav aria-label="Main navigation">
<a asp-controller="Home" asp-action="Index">Overview</a>
<a asp-controller="Books" asp-action="Index">Books</a>@if(User.IsInRole("Reader")){
<a asp-controller="MyLoans" asp-action="Index">My loans</a>
}
@if(User.IsInRole("Admin")){
<a asp-controller="Readers" asp-action="Index">Readers</a>
<a asp-controller="Loans" asp-action="Index">Loans</a>
}@* 提交表单由标签助手生成防伪字段，服务端负责授权和业务校验。 *@
<form asp-controller="Account" asp-action="Logout" method="post">
<button class="quiet" type="submit">Sign out</button>
</form>
</nav>
}
</header>
@* 主区域承载一次性成功提示和具体页面。 *@
<main>@if(TempData["Success"] is string message){
<div class="notice" role="status">@message</div>
}
@RenderBody()</main>
<footer>Library Lending <span>Keep your collection connected.</span>
</footer>
@* 本站脚本仅改善提交反馈，幂等与并发约束由服务器保证。 *@
<script src="~/js/forms.js" asp-append-version="true">
</script>
</body>
</html>
