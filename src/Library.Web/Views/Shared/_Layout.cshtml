<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Library Lending</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">L</span> Library Lending</a>
@if(User.Identity?.IsAuthenticated == true){<nav aria-label="Main navigation"><a asp-controller="Home" asp-action="Index">Overview</a>@if(User.IsInRole("Admin")){<a asp-controller="Books" asp-action="Index">Books</a><a asp-controller="Readers" asp-action="Index">Readers</a><a asp-controller="Loans" asp-action="Index">Loans</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="quiet" type="submit">Sign out</button></form></nav>}
</header><main>@if(TempData["Success"] is string message){<div class="notice" role="status">@message</div>}@RenderBody()</main><footer>Library Lending <span>Keep your collection connected.</span></footer><script src="~/js/forms.js" asp-append-version="true"></script></body></html>
