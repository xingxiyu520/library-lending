<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 目标运行时使用.NET 8。 -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- 启用可空引用检查。 -->
    <Nullable>enable</Nullable>
    <!-- 导入SDK通用命名空间。 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 启用Visual Studio测试项目发现。 -->
    <IsTestProject>true</IsTestProject>
    <!-- 启用MSTest运行器。 -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <!-- 生成可独立执行的测试入口。 -->
    <OutputType>Exe</OutputType>
    <!-- 允许dotnet test调用统一测试平台。 -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- 保留测试输出的原始流。 -->
    <TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>
    <!-- 失败时显示具体用例。 -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <!-- 测试项目不发布为NuGet包。 -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Visual Studio测试发现和运行基础设施。 -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
    <!-- Visual Studio Run All使用的MSTest适配器。 -->
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4"/>
    <!-- 生成可追溯的本地TRX原始结果。 -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.4.3"/>
    <!-- MSTest测试特性、数据用例及断言。 -->
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4"/>
    <!-- 通过真实MVC与Identity管道执行HTTP集成测试。 -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.25"/>
    <!-- 驱动真实浏览器执行端到端用例。 -->
    <PackageReference Include="Selenium.WebDriver" Version="4.27.0"/>
    <!-- 显式等待与浏览器定位辅助。 -->
    <PackageReference Include="Selenium.Support" Version="4.27.0"/>
  </ItemGroup>
  <ItemGroup>
    <!-- 测试直接引用当前Web实现。 -->
    <ProjectReference Include="../../src/Library.Web/Library.Web.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <!-- 统一导入MSTest特性和断言。 -->
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
  </ItemGroup>
</Project>
